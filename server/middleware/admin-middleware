const adminMiddleware = async (req, res, next) => {
    try {
        const verified = req.user.isAdmin;

        if (!verified) {
            return res.status(403).json({
                message: "Access denied. User does not have admin access."
            });
        }

        next();
    } catch (error) {
        next(error);
    }
};

module.exports = adminMiddleware;